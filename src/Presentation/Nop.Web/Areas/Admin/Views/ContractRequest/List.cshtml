@* [Mahjar contracts] contract request list *@
@using Nop.Web.Areas.Admin.Models.Mahjar
@model ContractRequestSearchModel

@{
    //page title
    ViewBag.PageTitle = T("admin.mahjar.contracts.list.title").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Contract requests");
}

@{
    const string hideSearchBlockAttributeName = "ContractRequestsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("admin.mahjar.contracts.list.title")
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>
<section class="content">
    <div class="container-fluid">
    <div class="form-horizontal">
        <div class="cards-group">
            <div class="card card-default card-search">
                <div class="card-body">
                    <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                        <div class="search-text">@T("Admin.Common.Search")</div>
                        <div class="icon-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
                        <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                    </div>

                    <div class="search-body @(hideSearchBlock ? "closed" : "")">

                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="CreatedFrom" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="CreatedFrom" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="CreatedTo" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="CreatedTo" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="StatusId" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-select asp-for="StatusId" asp-items="Model.AvailableStatuses" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="text-center col-12">
                                <button type="button" id="search-contractrequests" class="btn btn-primary btn-search">
                                    <i class="fas fa-magnifying-glass"></i>
                                    @T("Admin.Common.Search")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "contractrequests-grid",
                        UrlRead = new DataUrl("List", "ContractRequest", null),
                        SearchButtonId = "search-contractrequests",
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                        Filters = new List<FilterParameter>
                        {
                            new FilterParameter(nameof(Model.CreatedFrom), typeof(DateTime?)),
                            new FilterParameter(nameof(Model.CreatedTo), typeof(DateTime?)),
                            new FilterParameter(nameof(Model.StatusId))
                        },
                        ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(ContractRequestModel.Number))
                            {
                                Title = "#",
                                Width = "120"
                            },
                            new ColumnProperty(nameof(ContractRequestModel.CustomerEmail))
                            {
                                Title = T("admin.mahjar.contracts.fields.customer").Text,
                                Width = "250",
                                Render = new RenderCustom("renderColumnCustomerInfo")
                            },
                            new ColumnProperty(nameof(ContractRequestModel.CreatedOn))
                            {
                                Title = T("admin.mahjar.contracts.fields.createdon").Text,
                                Width = "150",
                                Render = new RenderDate()
                            },
                            new ColumnProperty(nameof(ContractRequestModel.Status))
                            {
                                Title = T("admin.mahjar.contracts.fields.status").Text,
                                Width = "180"
                            },
                            new ColumnProperty(nameof(ContractRequestModel.GrandTotal))
                            {
                                Title = T("admin.mahjar.contracts.fields.total").Text,
                                Width = "120"
                            },
                            new ColumnProperty(nameof(ContractRequestModel.SignedOn))
                            {
                                Title = T("admin.mahjar.contracts.fields.signedon").Text,
                                Width = "150",
                                Render = new RenderDate()
                            },
                            new ColumnProperty(nameof(ContractRequestModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "100",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderButtonEdit(new DataUrl("~/Admin/ContractRequest/Edit"))
                            }
                        }
                    })

                    <script asp-location="Footer">
                        function renderColumnCustomerInfo(data, type, row, meta) {
                            var textRenderer = $.fn.dataTable.render.text().display;
                            return '<a href="@Url.Content("~/Admin/Customer/Edit/")' + row.CustomerId + '">' + textRenderer(row.CustomerEmail) + '</a>';
                        }
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
