@* [Mahjar home-slides] the slide texts, one tab per language (Standard = the fallback for a language left empty) *@
@using Nop.Web.Areas.Admin.Models.Mahjar
@model HomeSlideModel

<div class="card-body">
    <p class="text-muted mhgr-hs-help"><i class="fas fa-circle-info"></i> @T("admin.mahjar.homeslides.content.hint")</p>
    @(await Html.LocalizedEditorAsync<HomeSlideModel, HomeSlideLocalizedModel>("homeslide-localized",
    @<div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="@Model.Locales[item].Kicker" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="@Model.Locales[item].Kicker" />
                <span asp-validation-for="@Model.Locales[item].Kicker"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="@Model.Locales[item].Title" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="@Model.Locales[item].Title" />
                <span asp-validation-for="@Model.Locales[item].Title"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="@Model.Locales[item].Subtitle" />
            </div>
            <div class="col-md-9">
                <nop-textarea asp-for="@Model.Locales[item].Subtitle" />
                <span asp-validation-for="@Model.Locales[item].Subtitle"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="@Model.Locales[item].ButtonText" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="@Model.Locales[item].ButtonText" />
                <span asp-validation-for="@Model.Locales[item].ButtonText"></span>
            </div>
        </div>
        <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
    </div>
    ,
    @<div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Kicker" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Kicker" />
                <span asp-validation-for="Kicker"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Title" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Title" asp-required="true" />
                <span asp-validation-for="Title"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Subtitle" />
            </div>
            <div class="col-md-9">
                <nop-textarea asp-for="Subtitle" />
                <span asp-validation-for="Subtitle"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ButtonText" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ButtonText" />
                <span asp-validation-for="ButtonText"></span>
            </div>
        </div>
    </div>))
</div>
