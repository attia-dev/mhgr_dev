@model ProductModel

@*[Mahjar item-status] Real photos OF THIS EXACT PIECE, each with a caption. The grid is the product-pictures
    grid of the multimedia card, retargeted at the ProductItemStatusPhoto* endpoints; the uploader underneath is
    the shared FilePond editor template, which reads its endpoint from ViewData.*@
<div class="card-body">
    @await Html.PartialAsync("Table", new DataTablesModel
    {
        Name = "productitemstatusphotos-grid",
        UrlRead = new DataUrl("ProductItemStatusPhotoList", "Product", new RouteValueDictionary { [nameof(Model.ItemStatusPictureSearchModel.ProductId)] = Model.ItemStatusPictureSearchModel.ProductId }),
        UrlDelete = new DataUrl("ProductItemStatusPhotoDelete", "Product", null),
        UrlUpdate = new DataUrl("ProductItemStatusPhotoUpdate", "Product", null),
        Length = Model.ItemStatusPictureSearchModel.PageSize,
        LengthMenu = Model.ItemStatusPictureSearchModel.AvailablePageSizes,
        ColumnCollection = new List<ColumnProperty>
        {
            new ColumnProperty(nameof(ProductItemStatusPictureModel.PictureUrl))
            {
                Title = T("Admin.Catalog.Products.ItemStatus.Fields.Picture").Text,
                Render = new RenderCustom("renderItemStatusColumnPhotoUrl"),
                ClassName = "text-center preview",
                Width = "150"
            },
            new ColumnProperty(nameof(ProductItemStatusPictureModel.Caption))
            {
                Title = T("Admin.Catalog.Products.ItemStatus.Fields.Caption").Text,
                Width = "400",
                Editable = true,
                EditType = EditType.String
            },
            new ColumnProperty(nameof(ProductItemStatusPictureModel.DisplayOrder))
            {
                Title = T("Admin.Catalog.Products.ItemStatus.Fields.DisplayOrder").Text,
                Width = "150",
                ClassName = NopColumnClassDefaults.CenterAll,
                Editable = true,
                EditType = EditType.Number
            },
            new ColumnProperty(nameof(ProductItemStatusPictureModel.Id))
            {
                Title = T("Admin.Common.Edit").Text,
                Width = "200",
                ClassName = NopColumnClassDefaults.Button,
                Render = new RenderButtonsInlineEdit()
            },
            new ColumnProperty(nameof(ProductItemStatusPictureModel.Id))
            {
                Title = T("Admin.Common.Delete").Text,
                Width = "100",
                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                ClassName = NopColumnClassDefaults.Button
            }
        }
    })

    <script>
        function renderItemStatusColumnPhotoUrl(data, type, row, meta) {
            return '<a href="' + row.PictureUrl + '" target="_blank"><img alt="' + row.PictureId + '" src="' + row.PictureUrl + '" /></a>';
        }
    </script>

    <div class="card card-default">
        <div class="card-header">
            @T("Admin.Catalog.Products.ItemStatus.Photos.AddNew")
        </div>
        <div class="card-body">
            <div class="form-group row">
                @{
                    //[Mahjar item-status] these two keys are the ONLY wiring of the MultiPicture uploader and
                    //are read the moment the editor below renders, so they must sit immediately above it
                    ViewData["Endpoint"] = this.Url.Action("ProductItemStatusPhotoAdd", "Product", new { productId = Model.Id });
                    ViewData["TableSelector"] = "#productitemstatusphotos-grid";
                }
                <div class="col-md-3">
                    <nop-label asp-for="AddItemStatusPictureModel.PictureId" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="AddItemStatusPictureModel.PictureId" />
                    <span asp-validation-for="AddItemStatusPictureModel.PictureId"></span>
                </div>
            </div>
        </div>
    </div>
</div>
