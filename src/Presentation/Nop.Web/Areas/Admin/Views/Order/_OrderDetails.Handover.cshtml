@* [Mahjar handover] the handover desk employee this order belongs to: they alone hand its items over to the
    customer and, for a rental, take them back. The whole order page is ONE form posting to Order/Edit, so the
    button below is a plain submit named "assign-handover" — never a nested form. *@
@model OrderModel

<div class="card-body">
    <p class="text-muted">@T("admin.mahjar.handover.assign.hint")</p>

    <div class="form-group row">
        <div class="col-md-3">
            <div class="label-wrapper">
                <label class="col-form-label">@T("admin.mahjar.handover.fields.assignedto")</label>
            </div>
        </div>
        <div class="col-md-9">
            <div class="form-text-row">
                @if (string.IsNullOrEmpty(Model.AssignedHandoverStaffName))
                {
                    <span class="text-muted">@T("admin.mahjar.handover.assign.none")</span>
                }
                else
                {
                    <strong>@Model.AssignedHandoverStaffName</strong>
                }
            </div>
        </div>
    </div>

    @if (Model.CanAssignHandover)
    {
        @if (Model.AvailableHandoverStaff.Any())
        {
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="AssignedHandoverStaffId" />
                </div>
                <div class="col-md-9">
                    <div class="input-group input-group-short">
                        <nop-select asp-for="AssignedHandoverStaffId" asp-items="Model.AvailableHandoverStaff" />
                        <div class="input-group-btn">
                            <button type="submit" name="assign-handover" class="btn btn-primary">
                                <i class="fas fa-user-check"></i>
                                @T("admin.mahjar.handover.assign.button")
                            </button>
                        </div>
                    </div>
                    <span asp-validation-for="AssignedHandoverStaffId"></span>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">@T("admin.mahjar.handover.assign.nostaff")</div>
        }
    }
</div>
